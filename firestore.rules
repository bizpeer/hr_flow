rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/UserProfile/$(uid); }
    function companyPath(id) { return /databases/$(database)/documents/companies/$(id); }
    function profile() { return get(profilePath(request.auth.uid)).data; }
    function role() { return profile().role; }
    function companyId() { return profile().companyId; }
    function superAdmin() { return signedIn() && role() == 'SUPER_ADMIN'; }
    function admin() { return signedIn() && role() == 'ADMIN'; }
    function manager() { return signedIn() && role() in ['ADMIN', 'SUB_ADMIN']; }
    function sameCompany(id) {
      return signedIn() && id is string && id != '' && companyId() == id;
    }
    function companyAdmin(id) { return admin() && sameCompany(id); }
    function companyManager(id) { return manager() && sameCompany(id); }
    function divisionManager(id, divisionId) {
      return sameCompany(id) && role() == 'SUB_ADMIN' &&
        divisionId is string && divisionId != '' &&
        profile().divisionId == divisionId;
    }
    function owner(id, uid) {
      return exists(companyPath(id)) && get(companyPath(id)).data.adminUid == uid;
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validApproval() {
      return onlyChanged(['status', 'updatedAt', 'updatedBy']) &&
        request.resource.data.status in ['PENDING', 'SUB_APPROVED', 'APPROVED', 'REJECTED'] &&
        (companyAdmin(resource.data.companyId) ||
          (divisionManager(resource.data.companyId, resource.data.divisionId) &&
            resource.data.status == 'PENDING' &&
            request.resource.data.status in ['SUB_APPROVED', 'REJECTED']));
    }

    match /companies/{id} {
      allow read: if superAdmin() || sameCompany(id);
      // Signup creates a company, then its owner's ADMIN profile.
      allow create: if signedIn() && id != 'PLATFORM' &&
        !exists(profilePath(request.auth.uid)) &&
        request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.plan == 'FREE' &&
        request.resource.data.keys().hasOnly([
          'nameKo', 'nameEn', 'domain', 'adminUid', 'createdAt', 'status', 'plan'
        ]);
      // Subscription, ownership and account status are platform controlled.
      allow update: if superAdmin() ||
        (companyAdmin(id) && onlyChanged(['domain', 'updatedAt', 'updatedBy', 'lastBackupAt'])) ||
        (signedIn() && !exists(profilePath(request.auth.uid)) &&
          resource.data.adminUid == request.auth.uid &&
          onlyChanged(['nameKo', 'nameEn', 'domain']));
      allow delete: if superAdmin();
    }

    match /divisions/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if superAdmin() || companyAdmin(request.resource.data.companyId);
      allow update: if superAdmin() ||
        (companyAdmin(resource.data.companyId) && unchanged(['companyId']));
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }

    match /teams/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if superAdmin() || companyAdmin(request.resource.data.companyId);
      allow update: if superAdmin() ||
        (companyAdmin(resource.data.companyId) && unchanged(['companyId']));
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }

    match /UserProfile/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || superAdmin() || companyAdmin(resource.data.companyId) ||
          divisionManager(resource.data.companyId, resource.data.divisionId));
      // Employees are created by the Admin SDK. The browser may create only its
      // own initial ADMIN profile for a company it registered.
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'ADMIN' &&
        request.resource.data.companyId != 'PLATFORM' &&
        owner(request.resource.data.companyId, uid);
      allow update: if signedIn() && (
        superAdmin() ||
        (request.auth.uid == uid &&
          unchanged(['uid', 'email', 'role', 'companyId', 'status']) &&
          (resource.data.role == 'ADMIN' || onlyChanged([
            'name', 'mustChangePassword', 'lastPasswordChange'
          ]))) ||
        (request.auth.uid != uid && companyAdmin(resource.data.companyId) &&
          resource.data.role != 'SUPER_ADMIN' &&
          request.resource.data.role in ['ADMIN', 'SUB_ADMIN', 'MEMBER'] &&
          unchanged(['uid', 'email', 'companyId']) &&
          (!owner(resource.data.companyId, uid) || unchanged(['role', 'status'])))
      );
      allow delete: if superAdmin() ||
        (companyAdmin(resource.data.companyId) && request.auth.uid != uid &&
          resource.data.role != 'SUPER_ADMIN' && !owner(resource.data.companyId, uid));
    }

    match /expenses/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId) ||
        divisionManager(resource.data.companyId, resource.data.divisionId) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid);
      allow create: if sameCompany(request.resource.data.companyId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING';
      allow update: if (
        sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid &&
        resource.data.status == 'PENDING' &&
        unchanged(['companyId', 'userId', 'status', 'createdAt', 'divisionId', 'teamId'])
      ) || validApproval();
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid &&
          resource.data.status == 'PENDING');
    }

    match /leaves/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId) ||
        divisionManager(resource.data.companyId, resource.data.divisionId) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid);
      allow create: if sameCompany(request.resource.data.companyId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING';
      allow update: if validApproval();
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid &&
          resource.data.status == 'PENDING');
    }

    match /attendance/{id} {
      allow read: if superAdmin() || companyManager(resource.data.companyId) ||
        (sameCompany(resource.data.companyId) && resource.data.userId == request.auth.uid);
      allow create: if sameCompany(request.resource.data.companyId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in ['IN', 'OUT'];
      allow update, delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }

    match /notices/{id} {
      allow read: if superAdmin() || sameCompany(resource.data.companyId);
      allow create: if companyManager(request.resource.data.companyId) &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if companyManager(resource.data.companyId) &&
        unchanged(['companyId', 'authorId']);
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }

    match /AuditLogs/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if sameCompany(request.resource.data.companyId) &&
        (manager() || (request.resource.data.actionType == 'UPDATE_PASSWORD' &&
          request.resource.data.targetId == request.auth.uid));
      allow update: if false;
      allow delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }

    match /config/{id} {
      allow read: if superAdmin() || sameCompany(id);
      allow create, update: if superAdmin() || companyAdmin(id);
      allow delete: if superAdmin();
    }

    match /system_config/{id} {
      allow read: if signedIn();
      allow write: if superAdmin();
    }

    match /backup_tasks/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyAdmin(request.resource.data.companyId) &&
        request.resource.data.requestedBy == request.auth.uid;
      allow delete: if superAdmin();
    }

    match /payroll_records/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyAdmin(request.resource.data.companyId) &&
        request.resource.data.approvedBy == request.auth.uid;
      allow update, delete: if superAdmin() || companyAdmin(resource.data.companyId);
    }

    // A PayPal callback is only a claim. A platform administrator must verify
    // the transaction with PayPal before extending the subscription.
    match /payment_claims/{id} {
      allow read: if superAdmin() || companyAdmin(resource.data.companyId);
      allow create: if companyAdmin(request.resource.data.companyId) &&
        request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.orderId is string &&
        request.resource.data.orderId.matches('^[A-Za-z0-9_-]{6,80}$') &&
        id == request.resource.data.orderId &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.keys().hasOnly([
          'companyId', 'companyName', 'adminUid', 'adminName',
          'orderId', 'status', 'createdAt'
        ]);
      allow update, delete: if superAdmin();
    }

    // Payment records and all unspecified collections are platform only.
    match /{document=**} {
      allow read, write: if superAdmin();
    }
  }
}
